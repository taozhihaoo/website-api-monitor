# Patterns are relative to the build context root (docker-compose uses
# `build: ./backend`), so they must NOT be prefixed with "backend/".
__pycache__/
*.pyc
.venv/
.pytest-tmp/
.pytest_cache/
.ruff_cache/
*.db
*.sqlite3
.coverage
htmlcov/
.pip-install.log

# Never bake local secrets or caches into the image.
.env
.env.*
!.env.example
