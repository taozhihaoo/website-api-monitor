# SiteWatch configuration — copy to .env and fill in.
# All secrets are injected via environment variables. Never commit .env.

# --- required ----------------------------------------------------------------
# JWT signing secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# PostgreSQL password for the docker-compose database
POSTGRES_PASSWORD=

# --- general (optional) ------------------------------------------------------
APP_ENV=production            # "development" enables lax defaults; production REQUIRES SECRET_KEY
FRONTEND_PORT=8080            # host port for the web UI
POSTGRES_USER=sitewatch
POSTGRES_DB=sitewatch
CORS_ORIGINS=http://localhost:8080

# --- monitoring engine (optional) -------------------------------------------
# MAX_MONITORS_PER_USER=50     # per-account monitor limit
# MAX_CONCURRENT_CHECKS=10     # scheduler worker pool size
# SCHEDULER_SCAN_INTERVAL_SECONDS=10
# MAX_RESPONSE_BYTES=2000000   # response body cap per check
# CHECK_MAX_RETRIES=2          # bounded retries with exponential backoff
# RETENTION_DAYS=30            # check history pruning

# --- notifications (optional) ------------------------------------------------
# Webhooks are configured per-user in the UI (Settings page).
# WEBHOOK_ALLOW_PRIVATE_IPS=false  # allow webhook targets on private networks
# Email alerts require a full SMTP configuration; empty = email disabled:
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- demo seed (optional) ----------------------------------------------------
# Password for the demo account created by `python -m app.seed` (development/demo only).
DEMO_PASSWORD=
